{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": [
    "src/**/*",
    "gallery/**/*.ts",
    "gallery/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx"
  ]
}
